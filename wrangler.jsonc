{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocab",
      "migrations_dir": "migrations"
    }
  ]
}
