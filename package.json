{
  "name": "vocab-tool",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:assets",
    "deploy": "npm run build:assets && wrangler deploy",
    "build:assets": "node scripts/build-assets.mjs",
    "db:migrate": "wrangler d1 migrations apply vocab --remote",
    "db:migrate:local": "wrangler d1 migrations apply vocab --local",
    "build:data": "node scripts/convert-data.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/core.test.js test/quiz.test.js test/worker.test.js test/stars.test.js test/session-guard.test.js test/frontend-guards.test.js test/auth.test.js test/backup-import.test.js",
    "e2e": "node scripts/api-e2e.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "ui:baseline": "node scripts/ui-baseline.mjs",
    "a11y": "node scripts/a11y.mjs",
    "quiz:prompt": "node scripts/quiz.mjs prompt",
    "quiz:check": "node scripts/quiz.mjs check",
    "quiz:sample": "node scripts/quiz.mjs sample",
    "quiz:merge": "node scripts/quiz.mjs merge",
    "quiz:scan:truncation": "node scripts/quiz-truncation-scan.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.132.0",
    "xlsx": "^0.18.5"
  }
}
